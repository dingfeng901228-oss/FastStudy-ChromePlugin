{
  "name": "faststudy-chrome-plugin",
  "displayName": "FastStudy 日语生词收藏",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Save Japanese vocabulary from any webpage to FastStudy (jp.frank2025.com). Right-click selected Japanese text to collect.",
